# --- LLM provider: groq | ollama | openai | anthropic ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=
GROQ_REASONING_EFFORT=low

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING=off

# --- Databases ---
MONGO_URI=mongodb://admin:admin123@localhost:27017
MONGO_DB=enterprise
QDRANT_URL=http://localhost:6333

# --- Memory ---
CHECKPOINTER=mongo
MEMORY_ENABLED=true
MEMORY_MIN_SCORE=0.55

# --- API (key:user pairs; ADMIN_USERS may upload documents) ---
API_KEYS=change-me-key-1:alice,change-me-key-2:bob
ADMIN_USERS=alice

LOG_FORMAT=text
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=enterprise-assistant
LANGSMITH_HIDE_IO=false