# ---------- LLM ----------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=
GROQ_REASONING_EFFORT=low

# ---------- Databases (docker compose reads these two to build the connection string) ----------
# Use letters and digits only (no @ : / characters). Generate: python -c "import secrets; print(secrets.token_hex(16))"
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_to_a_long_random_value

# Only used when running WITHOUT docker (python/uvicorn on your machine):
MONGO_URI=mongodb://admin:change_me_to_a_long_random_value@localhost:27017
QDRANT_URL=http://localhost:6333

# ---------- Memory ----------
CHECKPOINTER=mongo
MEMORY_ENABLED=true
MEMORY_MIN_SCORE=0.55

# ---------- API access: "key:user" pairs. Generate keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=replace_with_long_random_key_1:alice,replace_with_long_random_key_2:demo
ADMIN_USERS=alice

# ---------- Observability ----------
LOG_FORMAT=text
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-assistant
LANGSMITH_HIDE_IO=false

# ---------- Production only (docker-compose.prod.yml) ----------
SITE_ADDRESS=assistant.example.com
# Optional: image from ECR instead of building on the server
# APP_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/enterprise-assistant:latest